[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=ru.vkr.JitsiAuroraPrototype
Exec=/usr/bin/ru.vkr.JitsiAuroraPrototype
Name=Jitsi Meet
Name[ru]=Jitsi Meet

[X-Application]
